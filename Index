<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#0e0a12">
<meta name="description" content="A fast action RPG. Slay hordes with friends, hunt legendary loot, and battle in the PvP arena.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" href="icon-192.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<title>Realm of Embers</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0e0a12;--panel:#1b1422;--panel2:#261c30;--line:#3b2e4a;--gold:#e8b94a;--gold2:#ffd77a;--red:#e2504b;--blue:#4a8fe8;--text:#efe6d8;--muted:#a99cb6}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;overflow:hidden;user-select:none;-webkit-user-select:none}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
.screen{position:fixed;inset:0;overflow-y:auto;background:radial-gradient(ellipse at top,#2a1a3a 0%,var(--bg) 65%);z-index:5}
.inner{max-width:560px;margin:0 auto;padding:16px 14px 40px}
h1,h2,h3{font-family:Cinzel,serif;letter-spacing:.5px}
h1{font-size:36px;margin:14px 0 2px;color:var(--gold2);text-align:center;text-shadow:0 0 24px rgba(232,185,74,.5)}
h2{font-size:22px;margin:6px 0 10px;color:var(--gold2)}
h3{font-size:17px;margin:0 0 4px}
.sub{color:var(--muted);text-align:center;margin:0 0 18px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0}
.row{display:flex;gap:10px;align-items:center}.between{justify-content:space-between}
.muted{color:var(--muted)}.small{font-size:13px}.center{text-align:center}
button{font:inherit;font-weight:700;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:12px;padding:11px 14px;cursor:pointer}
button:active{transform:scale(.97)}
button.primary{background:linear-gradient(180deg,var(--gold2),var(--gold));color:#2a1a08;border:0;box-shadow:0 0 16px rgba(232,185,74,.35)}
button:disabled{opacity:.4}
